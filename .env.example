# ===== Shopify App 凭证（Partners Dashboard → App setup） =====
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# 应用对外地址（Railway 域名，形如 https://your-app.up.railway.app）
SHOPIFY_APP_URL=
# 逗号分隔的 OAuth scope，本脚手架示例不需要额外 scope，留空即可
SCOPES=
# 可选：Shopify Plus 自定义域名（无需可删除）
# SHOP_CUSTOM_DOMAIN=

# ===== PostgreSQL（Railway 项目内一键添加 PostgreSQL 自动注入） =====
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== S3 兼容对象存储（Cloudflare R2 / Backblaze B2 / AWS S3） =====
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=app-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 / B2 建议 true（路径风格寻址）；AWS S3 虚拟主机风格可设 false
S3_FORCE_PATH_STYLE=true

# ===== 文件生命周期 =====
# 文件保留天数：files.expiresAt = 上传时间 + 该天数，过期由清理任务回收
FILE_RETENTION_DAYS=30
# 清理任务密钥：Railway Cron 请求 POST /cron/cleanup 时需携带 Authorization: Bearer <值>
CRON_SECRET=
